{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver"
            ],
            "django": true
        },
        {
            "name": "Tests debug",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                //"api.tests.test_auth",
                "api.tests.test_user_risk_calculations"
            ],
            "justMyCode": false,
            "django": true,
            "program": "${workspaceFolder}\\manage.py",
        },
        {
            "name": "Seed: Local (Token, 10 users)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_fake_users.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--base-url",
                "http://127.0.0.1:8000",
                "--users-endpoint",
                "/demo/api/users/",
                "--lifestyle-endpoint",
                "/demo/api/user-lifestyles/",
                "--count",
                "10",
                "--auth",
                "token",
                "--token",
                ""
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Seed: WEB (Token, 10 users)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/seed_fake_users.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--base-url",
                "http://52.4.150.16/",
                "--users-endpoint",
                "/demo/api/users/",
                "--lifestyle-endpoint",
                "/demo/api/user-lifestyles/",
                "--count",
                "10",
                "--auth",
                "token",
                "--token",
                ""
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
    ]
}