{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\manage.py",
            "args": [
                "runserver"
            ],
            "django": true
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests debug",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "test",
                //"api.tests.test_air_quality_bad_conditions"
                //"api.tests.test_movement_upload_integration",
                //"api.tests.test_movement_upload_csv"
                //"api.tests.test_meta_choices",
                //"api.tests.test_user_life_style",
                //"api.tests.test_mommy_baby_symptoms_api",
                //"api.tests.test_auth",
                //"api.tests.test_user_risk_calculations"
                "api.tests.test_aggregation",
            ],
            "justMyCode": false,
            "django": true,
            "program": "${workspaceFolder}\\manage.py",
        },
