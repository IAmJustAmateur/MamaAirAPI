# Django settings
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=your-very-secure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,api.mamaair.work
DOMAIN=api.mamaair.work
ACME_EMAIL=service@mamaair.work

# PostgreSQL settings
DB_NAME=agent_api_db
DB_USER=agent_api_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

REGISTRATION_API_KEY=your-registration-api-key
# Comma-separated Google OAuth client IDs accepted by mobile sign-in.
GOOGLE_ALLOWED_AUDS=your-mobile-client-id.apps.googleusercontent.com
FIREBASE_CREDENTIALS=/run/secrets/firebase_service_account.json

# Movement location processing
MOVEMENT_H3_RESOLUTION=8
MOVEMENT_COORDINATE_ACTIVE_KEY_VERSION=1
# JSON map of key version to a base64-encoded 32-byte AES key.
# Keep production keys in the deployment secret store, never in Git.
MOVEMENT_COORDINATE_KEYS={}

# Health insight snapshots freshness window.
# Set to 0 in dev/staging to force regeneration on every /api/advice/ or /api/summary/ request.
HEALTH_INSIGHT_SNAPSHOT_FRESH_HOURS=6

# Asynchronous account email (worker and web need the same settings).
CELERY_BROKER_URL=redis://redis:6379/0
AUTH_REDIS_CACHE_URL=redis://redis:6379/1
AUTH_PUBLIC_URL=https://api.mamaair.work
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply.mamaair@gmail.com
EMAIL_HOST_PASSWORD=replace-with-google-app-password
DEFAULT_FROM_EMAIL="MamaAir <noreply.mamaair@gmail.com>"
SUPPORT_EMAIL=service@mamaair.work
